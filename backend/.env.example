PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?appName=<app>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=replace_with_64_char_random_hex
JWT_RESET_EXPIRES_IN=15m

# Admin registration key (sent as X-Registration-Key header)
ADMIN_REGISTRATION_KEY=replace_with_strong_random_key

# CORS — comma-separated frontend origin(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
NODE_ENV=development

# Email (future — for password reset delivery)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your@email.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM="Solar Platform <noreply@yourdomain.com>"
